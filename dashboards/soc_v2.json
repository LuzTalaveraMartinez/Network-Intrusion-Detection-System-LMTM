              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "ffls8epc1czk0b"
                    },
                    "group": "loki",
                    "kind": "DataQuery",
                    "spec": {
                      "direction": "backward",
                      "editorMode": "code",
                      "expr": "{job=\"snort\"} | pattern \"<_> <timestamp> [<_>] <msg>\" | msg != \"\" | line_format \"  {{if contains \\\"Priority: 1\\\" .msg}}🔴{{else if contains \\\"Priority: 2\\\" .msg}}🟠{{else}}🟡{{end}} {{.timestamp}} | {{.msg}}\"\r\n\r\n",
                      "queryType": "range"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
